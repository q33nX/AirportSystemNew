@page "/"
@rendermode InteractiveServer
@inject IJSRuntime JSRuntime
@inject IFlightSearchService FlightSearchService
@using AirportSystem.Core.Entities
@using AirportSystem.Core.Services
@using AirportSystem.Core.Interfaces
@using AirportSystem.Core.ViewModels
@using AirportSystem.Core.Enums
@using Microsoft.AspNetCore.Components

<PageTitle>Поиск авиабилетов</PageTitle>

@namespace AirportSystem.Components.Pages

<!-- Модальное окно для конкретного маршрута -->
@if (_selectedItinerary != null && _selectedItinerary.Flights?.Any() == true)
{
    <div class="modal fade show d-block avia-modal-backdrop" tabindex="-1" @onclick="CloseDetails">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable custom-modal-size" style="margin-top: 25px" @onclick:stopPropagation>
            <div class="modal-content border-0 shadow-lg rounded-5 overflow-hidden" style="max-width: 100% !important">

                @* Шапка окна *@
                <div class="modal-header border-0 p-4 bg-white sticky-top z-3">
                    <div class="d-flex align-items-center">
                        <div class="bg-primary text-white rounded-circle p-2 me-3">
                            <i class="bi bi-airplane-engines fs-4"></i>
                        </div>
                        <div>
                            <h3 class="fw-bold mb-0">Бронирование билета</h3>
                            <span class="text-muted">@_selectedItinerary.Flights.First().Schema.Origin.City.Name — @_selectedItinerary.Flights.Last().Schema.Destination.City.Name</span>
                        </div>
                    </div>
                    <button type="button" class="btn-close ms-auto" @onclick="CloseDetails"></button>
                </div>

                <div class="modal-body p-0">
                    <div class="container-fluid">
                        <div class="row g-0">
                            @* ЛЕВАЯ КОЛОНКА: МАРШРУТ (Таймлайн) *@
                            <div class="col-lg-7 p-5 border-end bg-light-subtle">
                                <h5 class="fw-bold mb-4">Ваш маршрут</h5>

                                @foreach (var (flight, index) in _selectedItinerary.Flights.Select((f, i) => (f, i)))
                                {
                                    var segDur = flight.ActualDuration;
                                    var segDurStr = $"{(int)segDur.TotalHours}ч {segDur.Minutes}м";

                                    <div class="segment-box bg-white p-4 rounded-4 shadow-sm mb-4 border border-light">
                                        <div class="d-flex justify-content-between mb-4">
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="badge bg-primary-subtle text-primary rounded-pill">@flight.Schema.Carrier.Name</span>
                                                <span class="text-muted small">Рейс @flight.Schema.FlightNumber</span>
                                            </div>
                                            <div class="text-muted small"><i class="bi bi-clock me-1"></i> @segDurStr</div>
                                        </div>

                                        <div class="d-flex justify-content-between align-items-start">
                                            <div class="text-start">
                                                <div class="h2 fw-bold mb-0">@flight.LocalDepartureTime.ToString("HH:mm")</div>
                                                <div class="fw-bold fs-5">@flight.Schema.Origin.Code</div>
                                                <div class="small text-muted text-truncate">@flight.Schema.Origin.City.Name</div>
                                                <div class="text-muted small">@flight.LocalDepartureTime.ToString("dd MMM, dddd")</div>
                                                @* <div class="small mt-2">Терминал </div> *@
                                            </div>

                                            <div class="flex-grow-1 px-4 text-center mt-3">
                                                <div class="position-relative">
                                                    <div class="border-bottom border-2 w-100 position-absolute top-50"></div>
                                                    <i class="bi bi-airplane-fill text-primary position-relative bg-white px-2 z-1"></i>
                                                </div>
                                                <div class="small text-muted mt-2">@flight.Aircraft.Model</div>
                                            </div>

                                            <div class="text-end">
                                                <div class="h2 fw-bold mb-0">@flight.LocalArrivalTime.ToString("HH:mm")</div>
                                                <div class="fw-bold fs-5">@flight.Schema.Destination.Code</div>
                                                <div class="small text-muted text-truncate">@flight.Schema.Destination.City.Name</div>
                                                <div class="text-muted small">@flight.LocalArrivalTime.ToString("dd MMM, dddd")</div>
                                                @* <div class="small mt-2">Терминал </div> *@
                                            </div>
                                        </div>
                                    </div>

                                    @if (index < _selectedItinerary.Flights.Count - 1)
                                    {
                                        var nextFlight = _selectedItinerary.Flights[index + 1];
                                        var waitTime = nextFlight.LocalDepartureTime - flight.LocalArrivalTime;
                                        <div class="transfer-pill mx-auto my-4 text-center">
                                            <span class="badge rounded-pill bg-warning-subtle text-dark p-2 px-3 border border-warning">
                                                <i class="bi bi-hourglass-split me-2"></i>Пересадка в @flight.Schema.Destination.City.Name: @((int)waitTime.TotalHours)ч @waitTime.Minutes м
                                            </span>
                                        </div>
                                    }
                                }
                            </div>

                            @* ПРАВАЯ КОЛОНКА: ТАРИФЫ, КЛАССЫ И ПАССАЖИРЫ *@
                            <div class="col-lg-5 p-5 bg-white d-flex flex-column">
                                <h5 class="fw-bold mb-4">Настройте ваш комфорт</h5>

                                @* 1. ВЫБОР КЛАССА ОБСЛУЖИВАНИЯ (Динамический) *@
                                <div class="mb-4">
                                    <label class="form-label fw-bold text-muted small text-uppercase">Класс обслуживания</label>
                                    <div class="row g-2">
                                        @foreach (var sClass in GetAvailableClassesForItinerary(_selectedItinerary))
                                        {
                                            <div class="col-6">
                                                <input type="radio" class="btn-check" name="modalServiceClass" id="modal_@sClass"
                                                       checked="@(_selectedServiceClass == sClass)"
                                                       @onchange="@(() => _selectedServiceClass = sClass)">
                                                <label class="btn btn-outline-primary w-100 p-3 rounded-4 text-start" for="modal_@sClass">
                                                    <span class="d-block fw-bold">@TranslateClass(sClass)</span>
                                                    <span class="small opacity-75">@GetClassDescription(sClass)</span>
                                                </label>
                                            </div>
                                        }
                                    </div>
                                </div>

                                @* 2. ВЫБОР ПАССАЖИРОВ *@
                                <div class="mb-4">
                                    <label class="form-label fw-bold text-muted small text-uppercase">Пассажиры</label>
                                    <div class="list-group list-group-flush border rounded-4 overflow-hidden">
                                        @* Взрослые *@
                                        <div class="list-group-item p-3 d-flex justify-content-between align-items-center">
                                            <div><i class="bi bi-person me-3"></i>Взрослые</div>
                                            <div class="d-flex align-items-center gap-3">
                                                <button type="button" class="btn btn-sm btn-passenger"
                                                        @onclick="() => ChangeAdults(-1)"
                                                        disabled="@(_adultsCount <= 1)">
                                                    <i class="bi bi-dash-lg"></i>
                                                </button>
                                                <span class="fw-bold" style="min-width: 20px; text-align: center;">@_adultsCount</span>
                                                <button type="button" class="btn btn-sm btn-passenger"
                                                        @onclick="() => ChangeAdults(1)"
                                                        disabled="@((_adultsCount + _childrenCount) >= 9)">
                                                    <i class="bi bi-plus-lg"></i>
                                                </button>
                                            </div>
                                        </div>
                                        @* Дети *@
                                        <div class="list-group-item p-3 d-flex justify-content-between align-items-center">
                                            <div><i class="bi bi-person-heart me-3"></i>Дети</div>
                                            <div class="d-flex align-items-center gap-3">
                                                <button type="button" class="btn btn-sm btn-passenger"
                                                        @onclick="() => ChangeChildren(-1)"
                                                        disabled="@(_childrenCount <= 0)">
                                                    <i class="bi bi-dash-lg"></i>
                                                </button>
                                                <span class="fw-bold" style="min-width: 20px; text-align: center;">@_childrenCount</span>
                                                <button type="button" class="btn btn-sm btn-passenger"
                                                        @onclick="() => ChangeChildren(1)"
                                                        disabled="@((_adultsCount + _childrenCount) >= 9)">
                                                    <i class="bi bi-plus-lg"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                    @if ((_adultsCount + _childrenCount) >= 9)
                                    {
                                        <div class="text-danger small mt-2 px-1" style="font-size: 0.75rem;">
                                            <i class="bi bi-info-circle me-1"></i> Максимум 9 пассажиров
                                        </div>
                                    }
                                </div>

                                @* 3. ДОПОЛНИТЕЛЬНЫЕ УСЛУГИ *@
                                <div class="services-list mb-auto">
                                    <label class="form-label fw-bold text-muted small text-uppercase">Дополнительные услуги</label>
                                    <div class="list-group list-group-flush border rounded-4 overflow-hidden">
                                        <div class="list-group-item p-3 d-flex justify-content-between align-items-center">
                                            <div><i class="bi bi-briefcase me-3"></i>Доп. багаж</div>
                                            <input type="checkbox" class="form-check-input" @bind="_hasExtraBaggage">
                                        </div>
                                        <div class="list-group-item p-3 d-flex justify-content-between align-items-center">
                                            <div><i class="bi bi-shield-check me-3"></i>Страховка</div>
                                            <input type="checkbox" class="form-check-input" @bind="_hasInsurance">
                                        </div>
                                    </div>
                                </div>

                                @* Итог *@
                                <div class="price-card p-4 rounded-5 bg-dark text-white shadow-lg mt-4">
                                    <div class="d-flex justify-content-between align-items-end mb-3">
                                        <div>
                                            <div class="text-white-50 small">ИТОГО К ОПЛАТЕ</div>
                                            <div class="display-5 fw-bold mb-0">
                                                @CalculateTotalPrice().ToString("N0") <span class="fs-4">₽</span>
                                            </div>
                                        </div>
                                        <div class="text-end text-white-50 small">@(_adultsCount + _childrenCount) пасс.</div>
                                    </div>
                                    <button class="btn btn-warning w-100 py-3 rounded-pill fw-bold fs-5 text-uppercase">Сохранить маршрут</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}


<!-- Поиск -->
<div class="search-section @(_isSearchPerformed ? "mini" : "full-screen")">
    <div class="container">
        <h2 class="text-center fw-bold mb-5 text-white">Поиск авиабилетов</h2>

        <div class="avia-tabs mb-3">
            @* Используем Enum вместо строк *@
            <button class="avia-tab @(_currentMode == SearchMode.Roundtrip ? "active" : "")"
                    @onclick='() => SetSearchMode(SearchMode.Roundtrip)'>
                Туда и обратно
            </button>
            <button class="avia-tab @(_currentMode == SearchMode.MultiCity ? "active" : "")"
                    @onclick='() => SetSearchMode(SearchMode.MultiCity)'>
                Сложный маршрут
            </button>
        </div>
        <div class="avia-panel shadow-lg">
            @if (_currentMode == SearchMode.Roundtrip)
            {
                <div class="main-search-row">
                    <CitySelect Placeholder="Откуда" Cities="_cities" OnCitySelected="c => _departureCity = c" />
                    <CitySelect Placeholder="Куда" Cities="_cities" OnCitySelected="c => _arrivalCity = c" />
                    <DateSelect Placeholder="Когда" SelectedDate="@_departureDate" MinDate="@DateTime.Now" OnDateSelected="@OnDepartureChanged" />
                    <DateSelect Placeholder="Обратно" SelectedDate="@_returnDate" MinDate="@(_departureDate ?? DateTime.Now)" OnDateSelected="@(d => _returnDate = d)" />
                    <button type="button" class="btn-search-main" @onclick="() => HandleSearch()">Найти</button>
                </div>
            }
            else
            {
                <div class="multi-city-container">
                    @foreach (var segment in Segments)
                    {
                        <div class="segment-row fade-in-row" @key="segment">
                            <CitySelect Placeholder="Откуда" Cities="_cities" OnCitySelected="c => segment.DepartureCity = c" />
                            <CitySelect Placeholder="Куда" Cities="_cities" OnCitySelected="c => segment.ArrivalCity = c"  />
                            <DateSelect Placeholder="Когда" MinDate="segment.MinDate ?? DateTime.Now.Date" OnDateSelected="d => OnSegmentDateChanged(segment, d)" />
                            
                            @if (Segments.Count > 2)
                            {
                                <button type="button" class="btn-remove-segment" @onclick="() => RemoveSegment(segment)">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z" /></svg>
                                </button>
                            }
                        </div>
                    }
                    <div class="multi-actions-row">
                        @if (Segments.Count < 5)
                        {
                            <button type="button" class="btn-add-segment" @onclick="AddSegment" disabled="@(Segments.Count >= 5)">
                                <i class="bi bi-plus-lg"></i> Добавить перелет
                            </button>
                        } else
                        {
                            <button type="button" class="btn-add-segment text-danger" disabled="@(Segments.Count >= 5)">
                                <i class="bi bi-plus-lg"></i> Достигнут лимит 5 перелётов!
                            </button>
                        }
                        <button type="button" class="btn-search-large" @onclick="HandleSearch">Найти</button>
                    </div>
                </div>
            }
        </div>
        <div class="avia-available mt-3 text-white">
            <a href="#">Просмотреть доступные направления</a>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_validationMessage))
{
    <div class="container mt-4">
        <div class="alert alert-warning" role="alert">
            @_validationMessage
        </div>
    </div>
}

<!-- Блок сортировки, фильтрации и вывода маршрутов -->
@if (_isSearchPerformed)
{
    @if (_allFoundFlights == null || !_allFoundFlights.Any())
    {
        <div class="container mt-5 mb-5 animate-results">
            <div class="row g-4">
                <div class="no-results-card p-5 text-center bg-white rounded-4 border">
                        <div class="mb-3">
                            <i class="bi bi-airplane fs-1 text-muted"></i>
                        </div>
                        <h5 class="fw-bold text-secondary mb-2">Рейсы не найдены</h5>
                        <p class="text-muted mb-0">Попробуйте изменить критерии поиска!</p>
                    </div>
            </div>
        </div>
    } else
    {
        <div class="container mt-5 mb-5 animate-results">
            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="sorting-panel mb-4 p-3 bg-white rounded-4 shadow-sm d-flex align-items-center gap-3 flex-wrap">
                        <span class="text-muted small fw-bold text-uppercase">Сортировка:</span>
                        <div class="d-flex gap-2">
                            <button class="btn btn-sort @(_activeSort == "price" ? "active" : "")" @onclick='() => SetSort("price")'>
                                Цена <i class="sort-icon @(_activeSort == "price" ? (_isAscending ? "asc" : "desc") : "")"></i>
                            </button>
                            <button class="btn btn-sort @(_activeSort == "duration" ? "active" : "")" @onclick='() => SetSort("duration")'>
                                Время <i class="sort-icon @(_activeSort == "duration" ? (_isAscending ? "asc" : "desc") : "")"></i>
                            </button>
                            <button class="btn btn-sort @(_activeSort == "comfort" ? "active" : "")" @onclick='() => SetSort("comfort")'>
                                Комфорт <i class="sort-icon @(_activeSort == "comfort" ? (_isAscending ? "asc" : "desc") : "")"></i>
                            </button>
                        </div>
                        <span class="ms-auto count-badge">
                            @if (_filteredFlights != null && _filteredFlights.Any())
                            {
                                <span>Найдено рейсов: @_filteredFlights.Count</span>
                            }
                        </span>
                    </div>

                    @if (_displayedFlights != null && _displayedFlights.Any())
                    {
                        @foreach (var itinerary in _displayedFlights.Where(it => it.Flights != null && it.Flights.Any()))
                        {
                            // Берем первый и последний сегменты для общей информации
                            var firstFlight = itinerary.Flights.First();
                            var lastFlight = itinerary.Flights.Last();
                            var isTop = itinerary.IsCheapest || itinerary.IsFastest || itinerary.IsMostComfortable;
                            var borderColor = itinerary.IsCheapest && itinerary.IsFastest ? "#6610f2" : 
                                              itinerary.IsCheapest && itinerary.IsMostComfortable ? "#0dcaf0" :
                                              itinerary.IsFastest && itinerary.IsMostComfortable ? "#fd7e14" :
                                              itinerary.IsCheapest ? "#198754" : 
                                              itinerary.IsFastest ? "#0d6efd" : 
                                              itinerary.IsMostComfortable ? "#ffc107" : "transparent";

                            <div class="ticket-card shadow-sm mb-4 bg-white animate-fade-in" style="border-left: 4px solid @borderColor !important;">
                                @if (isTop)
                                {
                                    <div class="d-flex gap-1 mb-2">
                                        @if (itinerary.IsCheapest)
                                        {
                                            <span class="badge bg-success">💰 Дешевый</span>
                                        }
                                        @if (itinerary.IsFastest)
                                        {
                                            <span class="badge bg-primary">⚡ Быстрый</span>
                                        }
                                        @if (itinerary.IsMostComfortable)
                                        {
                                            <span class="badge bg-warning text-dark">✨ Комфорт</span>
                                        }
                                    </div>
                                }
                                <div class="row g-0 align-items-stretch">
                                    <div class="col-md-9 p-4 d-flex align-items-center">
                                        <div class="w-100">
                                            <div class="flight-route-info">
                                                <div class="d-flex justify-content-between mb-2">
                                                    @* Статус берем у первого рейса или выводим общий *@
                                                    @* <span class="text-muted small fw-bold pe-3">@firstFlight.Status</span> *@
                                                    @* Если пересадка, можно вывести список номеров или только первый *@
                                                    <span class="text-muted small fw-bold pe-3">
                                                        @(itinerary.Flights.Count > 1 ? "Стыковочный рейс" : firstFlight.Schema.FlightNumber)
                                                    </span>
                                                </div>
                                                <div class="d-flex align-items-center justify-content-between text-center">
                                                    @* ОТКУДА: Берем из первого рейса *@
                                                    <div class="text-start" style="min-width: 85px;">
                                                        <div class="h3 fw-bold m-0 text-dark">@firstFlight.Schema.Origin.Code</div>
                                                        <div class="small text-muted text-truncate" style="max-width: 90px;">@firstFlight.Schema.Origin.City.Name</div>
                                                        <div class="small fw-bold text-secondary mt-1">@firstFlight.LocalDepartureTime.ToString("dd MMM")</div>
                                                    </div>

                                                    <div class="flex-grow-1 px-3">
                                                        <div class="mb-1">
                                                            @* Перевозчик первого рейса *@
                                                            @if (itinerary.IsSelfTransfer)
                                                            {
                                                                <span class="small fw-bold text-primary">Разные авиакомпании</span>
                                                            } else
                                                            {
                                                                <span class="small fw-bold text-primary">@firstFlight.Schema.Carrier.Name</span>
                                                            }
                                                            
                                                        </div>
                                                        <div class="mb-2">
                                                            <span class="h4 fw-bold text-primary">@firstFlight.LocalDepartureTime.ToString("HH:mm")</span>
                                                            <span class="mx-2 text-muted">—</span>
                                                            @* КУДА: Время прилета последнего рейса *@
                                                            <span class="h4 fw-bold text-primary">@lastFlight.LocalArrivalTime.ToString("HH:mm")</span>
                                                        </div>

                                                        @* Визуализация пути *@
                                                        <div class="path-line position-relative">
                                                            <i class="bi bi-airplane-fill"></i>
                                                            @if (itinerary.StopsCount > 0)
                                                            {
                                                                @* Точка пересадки на линии *@
                                                                <div class="transfer-dot" title="Пересадка в @string.Join(", ", itinerary.GetTransferCities())"></div>
                                                            }
                                                        </div>

                                                        <div class="mb-3">
                                                            @* Длительность из первого рейса (для прямого - это общая длительность) *@
                                                            @{
                                                                var td = firstFlight.ActualDuration;
                                                                var tdStr = $"{(int)td.TotalHours}ч {td.Minutes}м";
                                                            }
                                                            <span class="small fw-bold text-muted">@tdStr</span>
                                                            @if (itinerary.StopsCount > 0)
                                                            {
                                                                <div class="small text-warning fw-bold">@itinerary.StopsCount пересадка</div>
                                                            }
                                                        </div>
                                                    </div>

                                                    @* КУДА: Данные последнего рейса *@
                                                    <div class="text-end" style="min-width: 85px;">
                                                        <div class="h3 fw-bold m-0 text-dark">@lastFlight.Schema.Destination.Code</div>
                                                        <div class="small text-muted text-truncate" style="max-width: 90px;">@lastFlight.Schema.Destination.City.Name</div>
                                                        <div class="small fw-bold text-secondary mt-1">@lastFlight.LocalArrivalTime.ToString("dd MMM")</div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-3 p-4 border-start border-dashed bg-light d-flex flex-column justify-content-center text-center price-panel">
                                        <div class="text-muted small mb-1">Общая цена</div>
                                        @* Общая цена из Itinerary *@
                                        <div class="h2 fw-bold mb-3 text-primary">@itinerary.TotalBasePrice.ToString("N0")</div>
                                        <button class="btn btn-warning w-100 fw-bold text-white rounded-pill py-2 shadow-sm" @onclick="() => OpenDetails(itinerary)">Подробнее</button>
                                    </div>
                                </div>
                            </div>
                        }

                        @if (_displayedFlights.Count < _filteredFlights.Count)
                        {
                            <div class="text-center mt-5">
                                <button class="btn btn-outline-primary px-5 py-3 fw-bold rounded-pill shadow-sm load-more-btn" @onclick="LoadMore">
                                    Показать еще
                                </button>
                                <p class="text-muted small mt-2">Показано @_displayedFlights.Count из @_filteredFlights.Count рейсов</p>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="no-results-card p-5 text-center bg-white rounded-4 border">
                            <div class="mb-3">
                                <i class="bi bi-airplane fs-1 text-muted"></i>
                            </div>
                            <h5 class="fw-bold text-secondary mb-2">Рейсы не найдены</h5>
                            <p class="text-muted mb-0">Попробуйте изменить критерии фильтра</p>
                        </div>
                    }
                </div>

                <div class="col-lg-4 d-none d-lg-block">
                    <div class="filter-panel p-4 bg-white rounded-4 shadow-sm border sticky-top" style="top: 20px;" role="region" aria-label="Фильтры поиска">
                        <div class="filter-header d-flex justify-content-between align-items-center mb-4">
                            <h5 class="fw-bold m-0 text-dark">
                                <i class="bi bi-sliders2-vertical text-primary"></i>Фильтры
                            </h5>
                            <button class="btn btn-link btn-sm text-decoration-none p-0 filter-reset-btn" @onclick="ResetFilters">Сбросить все</button>
                        </div>

                        <div class="filter-section mb-4">
                            <label class="filter-label">Пересадки</label>
                            <div class="filter-scroll-area" style="max-height: 200px; overflow-y: auto;">
                                @if (_allFoundFlights != null && _allFoundFlights.Any())
                                {

                                    @foreach (var stops in _allFoundFlights
                                                            .Select(f => f.StopsCount)
                                                            .Distinct()
                                                            .OrderBy(s => s))
                                    {
                                        <div class="custom-check-item">
                                            <label class="check-container">
                                                <span class="check-text">
                                                    @(stops == 0 ? "Прямой рейс" : 
                                                      stops == 1 ? "1 пересадка" : 
                                                      $"{stops} пересадки")
                                                </span>
                                                <input type="checkbox"
                                                       checked="@_filters.AllowedStops.Contains(stops)"
                                                       @onchange="e => ToggleStops(stops, (bool)e.Value)">
                                                <span class="checkmark"></span>
                                            </label>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small">Сначала выполните поиск</span>
                                }
                            </div>
                        </div>

                        <div class="filter-section mb-4">
                            <label class="filter-label">Авиакомпании</label>
                            <div class="filter-scroll-area" style="max-height: 200px; overflow-y: auto;">
                                @if (_allFoundFlights != null && _allFoundFlights.Any())
                                {
                                    @foreach (var airline in _allFoundFlights
                                                            .SelectMany(it => it.Flights)
                                                            .Select(f => f.Schema.Carrier)
                                                            .GroupBy(c => c.IATACode)
                                                            .Select(g => g.First())
                                                            .OrderBy(a => a.Name))
                                    {
                                        <div class="custom-check-item">
                                            <label class="check-container">
                                                <span class="check-text">@airline.Name (@airline.IATACode)</span>
                                                <input type="checkbox"
                                                       checked="@_filters.SelectedAirlines.Any(a => a.IATACode == airline.IATACode)"
                                                       @onchange="@(e => ToggleAirline(airline, e.Value))">
                                                <span class="checkmark"></span>
                                            </label>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small">Сначала выполните поиск</span>
                                }
                            </div>
                        </div>

                        <div class="filter-section mb-4">
                            <label class="filter-label">Класс обслуживания</label>
                            <div class="time-grid">
                                @foreach (var sc in Enum.GetValues<ServiceClass>())
                                {
                                    <button class="time-chip @(_filters.SelectedClasses.Contains(sc) ? "active" : "")"
                                            @onclick="@(() => ToggleServiceClass(sc))">
                                        @if (sc == ServiceClass.Economy)
                                        {
                                            <i class="bi bi-person"></i>
                                        }
                                        else if (sc == ServiceClass.Comfort)
                                        {
                                            <i class="bi bi-cup-straw"></i>
                                        }
                                        else if (sc == ServiceClass.Business)
                                        {

                                            <i class="bi bi-briefcase"></i>
                                        }
                                        else if (sc == ServiceClass.First)
                                        {

                                            <i class="bi bi-star"></i>
                                        }
                                        else
                                        {

                                            <i class="bi bi-gem"></i>
                                        }

                                        <span>@sc.ToString()</span>
                                    </button>
                                }
                            </div>
                        </div>

                        <div class="filter-section mb-4">
                            <label class="filter-label">Дни вылета</label>
                            <div class="days-grid">
                                @foreach (DayOfWeek day in Enum.GetValues<DayOfWeek>())
                                {
                                    var d = day;
                                    <label class="day-item">
                                        <input type="checkbox" checked="@_filters.SelectedDays.Contains(d)"
                                               @onchange="@(e => ToggleDay(d, e.Value))">
                                        <span>@GetDayShortName(d)</span>
                                    </label>
                                }
                            </div>
                        </div>

                        <div class="filter-section mb-4">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <label class="filter-label m-0">Цена</label>
                                <span class="price-value-badge">до @_filters.MaxPrice.ToString("N0") ₽</span>
                            </div>

                            @* Используем @_minFoundPrice и @_maxFoundPrice в атрибутах *@
                            <input type="range" class="styled-range"
                                   min="@((double)_minFoundPrice)"
                                   max="@((double)_maxFoundPrice)"
                                   step="100"
                                   @bind="_filters.MaxPrice"
                                   @bind:event="oninput"
                                   @onchange="OnFilterChanged">

                            <div class="d-flex justify-content-between mt-2">
                                @* Текстовые подписи тоже делаем динамическими *@
                                <span class="range-limit">@_minFoundPrice.ToString("N0")</span>
                                <span class="range-limit">@_maxFoundPrice.ToString("N0")</span>
                            </div>
                        </div>

                        <div class="filter-section">
                            <label class="filter-label">Время вылета</label>
                            <div class="time-grid">
                                @foreach (var slot in new[] { ("Morning", "Утро", "bi-brightness-alt-high"), ("Day", "День", "bi-sun"), ("Evening", "Вечер", "bi-moon-stars"), ("Night", "Ночь", "bi-cloud-moon") })
                                {
                                    <button class="time-chip @(_filters.SelectedTimeSlots.Contains(slot.Item1) ? "active" : "")"
                                            @onclick="@(() => ToggleTimeSlot(slot.Item1))">
                                        <i class="bi @slot.Item3"></i>
                                        <span>@slot.Item2</span>
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
}


@code {
    // --- Поиск и Данные ---
    private City? _departureCity;
    private City? _arrivalCity;
    private DateTime? _departureDate;
    private DateTime? _returnDate;

    private List<City> _cities = new();
    private List<Itinerary> _allFoundFlights = new(); // Оригинальный результат поиска
    private List<Itinerary> _filteredFlights = new(); // Список после применения фильтров
    private List<Itinerary> _displayedFlights = new(); // Список для отрисовки (пагинация)

    // --- Состояние интерфейса ---
    private FlightFilterModel _filters = new();
    private bool _isSearching = false;
    private bool _isSearchPerformed = false;
    private string? _validationMessage;
    private int pageSize = 10;
    private string _activeSort = "price";
    private bool _isAscending = true;

    private decimal _minFoundPrice; // Минимальная цена в текущем поиске
    private decimal _maxFoundPrice; // Максимальная цена в текущем поиске

    private Itinerary? _selectedItinerary;

    private void OpenDetails(Itinerary itinerary)
    {
        _selectedItinerary = itinerary;
    }

    private void CloseDetails()
    {
        _selectedItinerary = null;
    }

    protected override async Task OnInitializedAsync()
    {
        _cities = await FlightSearchService.GetAvailableCitiesAsync();
    }

    // --- Логика Поиска ---
    private async Task HandleSearch()
    {
        // Всегда очищаем результаты перед новым поиском
        _allFoundFlights = new List<Itinerary>();
        _filteredFlights = new List<Itinerary>();
        _displayedFlights = new List<Itinerary>();

        // Проверка обязательных полей
        if (_currentMode == SearchMode.MultiCity)
        {
            var validSegments = Segments.Where(s => 
                s.DepartureCity != null && !string.IsNullOrEmpty(s.DepartureCity.IATACode) &&
                s.ArrivalCity != null && !string.IsNullOrEmpty(s.ArrivalCity.IATACode)).ToList();
            if (validSegments.Count < 2)
            {
                _isSearchPerformed = true;
                return;
            }
        }
        else
        {
            var fromEmpty = _departureCity == null || string.IsNullOrEmpty(_departureCity.IATACode);
            var toEmpty = _arrivalCity == null || string.IsNullOrEmpty(_arrivalCity.IATACode);
            var departureDateEmpty = !_departureDate.HasValue;
            var returnDateEmpty = !_returnDate.HasValue;

            if (fromEmpty && toEmpty && departureDateEmpty && returnDateEmpty)
            {
                _isSearchPerformed = true;
                return;
            }

            // Проверка: дата возврата только если есть Откуда, Куда и Дата вылета
            if (returnDateEmpty == false && (fromEmpty || toEmpty || departureDateEmpty))
            {
                _validationMessage = "Для поиска обратного рейса необходимо заполнить поля: Откуда, Куда и Дата вылета";
                _isSearchPerformed = true;
                return;
            }
        }

        _validationMessage = null;
        _isSearching = true;
        _isSearchPerformed = false;

        try
        {
            // 1. Получаем данные из сервиса
            if (_currentMode == SearchMode.MultiCity)
            {
                var segments = Segments
                    .Where(s => s.DepartureCity != null && s.ArrivalCity != null)
                    .Select(s => (s.DepartureCity, s.ArrivalCity, s.DepartureDate))
                    .ToList();

                _allFoundFlights = await FlightSearchService.SearchMultiCityAsync(segments);
            }
            else
            {
                _allFoundFlights = await FlightSearchService.SearchItinerariesAsync(
                    _departureCity,
                    _arrivalCity,
                    _departureDate,
                    _returnDate
                );
            }

            // ВЫЧИСЛЯЕМ ГРАНИЦЫ ЦЕН ДЛЯ ФИЛЬТРА
            if (_allFoundFlights.Any())
            {
                _minFoundPrice = _allFoundFlights.Min(f => f.TotalBasePrice);
                _maxFoundPrice = _allFoundFlights.Max(f => f.TotalBasePrice);
            }
            else
            {
                _minFoundPrice = 0;
                _maxFoundPrice = 250000;
            }

            // 2. Сбрасываем фильтры при новом глобальном поиске
            _filters = new FlightFilterModel { MaxPrice = _maxFoundPrice };

            // 3. Применяем фильтрацию и отображаем
            ApplyAllChanges();

            _isSearchPerformed = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Search error: {ex.Message}");
        }
        finally
        {
            _isSearching = false;
        }
    }

    private void ToggleAirline(Airline airline, object? isChecked)
    {
        bool checkedValue = Convert.ToBoolean(isChecked ?? false);
        if (checkedValue)
        {
            if (!_filters.SelectedAirlines.Any(a => a.IATACode == airline.IATACode))
                _filters.SelectedAirlines.Add(airline);
        }
        else
        {
            var toRemove = _filters.SelectedAirlines.FirstOrDefault(a => a.IATACode == airline.IATACode);
            if (toRemove != null) _filters.SelectedAirlines.Remove(toRemove);
        }

        OnFilterChanged();
    }

    // --- Логика Фильтрации ---
    private void OnFilterChanged()
    {
        ApplyAllChanges();
    }

    private void ToggleDay(DayOfWeek day, object? isChecked)
    {
        bool checkedValue = Convert.ToBoolean(isChecked ?? false);
        if (checkedValue) 
            _filters.SelectedDays.Add(day);
        else 
            _filters.SelectedDays.Remove(day);

        ApplyAllChanges();
    }

    private void ToggleStops(int stops, bool isChecked)
    {
        if (isChecked)
        {
            if (!_filters.AllowedStops.Contains(stops))
                _filters.AllowedStops.Add(stops);
        }
        else
        {
            _filters.AllowedStops.Remove(stops);
        }

        // Лог для быстрой отладки — смотрите консоль браузера / серверный вывод
        Console.WriteLine($"ToggleStops: stops={stops}, checked={isChecked}; currentAllowed=[{string.Join(",", _filters.AllowedStops)}]");

        ApplyAllChanges();
    }

    private void ToggleServiceClass(ServiceClass sc)
    {
        if (_filters.SelectedClasses.Contains(sc))
        {
            _filters.SelectedClasses.Remove(sc);
        }
        else
        {
            _filters.SelectedClasses.Add(sc);
        }
        OnFilterChanged();
    }

    private void ToggleTimeSlot(string slot)
    {
        if (_filters.SelectedTimeSlots.Contains(slot))
            _filters.SelectedTimeSlots.Remove(slot);
        else
            _filters.SelectedTimeSlots.Add(slot);

        ApplyAllChanges();
    }

    private void ResetFilters()
    {
        _filters = new FlightFilterModel
        {
            MaxPrice = _maxFoundPrice + 1000 // Сбрасываем к максимуму текущей выдачи
        };
        ApplyAllChanges();
    }

    // --- Центральный метод обновления данных ---
    private void ApplyAllChanges()
    {
        // 1. Фильтруем
        _filteredFlights = FlightSearchService.ApplyFilters(_allFoundFlights, _filters);

        // 2. Определяем топ-3 рейса
        _filteredFlights = FlightSearchService.MarkTopFlights(_filteredFlights);

        // 3. Сортируем
        SortFlightsInternal();

        // 4. Обновляем отображение (сбрасываем на первую страницу)
        _displayedFlights = _filteredFlights.Take(pageSize).ToList();

        StateHasChanged();
    }

    // --- Сортировка ---
    private void SetSort(string criterion)
    {
        if (_activeSort == criterion) _isAscending = !_isAscending;
        else
        {
            _activeSort = criterion;
            _isAscending = true;
        }
        ApplyAllChanges();
    }

    private void SortFlightsInternal()
    {
        if (!_filteredFlights.Any()) return;

        if (_activeSort == "price")
        {
            _filteredFlights = _isAscending
                ? _filteredFlights.OrderBy(f => f.TotalBasePrice).ToList()
                : _filteredFlights.OrderByDescending(f => f.TotalBasePrice).ToList();
        }
        else if (_activeSort == "duration")
        {
            _filteredFlights = _isAscending
                ? _filteredFlights.OrderBy(f => f.TotalDuration).ToList()
                : _filteredFlights.OrderByDescending(f => f.TotalDuration).ToList();
        }
        else if (_activeSort == "comfort")
        {
            _filteredFlights = _isAscending
                ? _filteredFlights.OrderBy(f => f.MaxComfortLevel).ToList()
                : _filteredFlights.OrderByDescending(f => f.MaxComfortLevel).ToList();
        }
    }

    // --- Вспомогательные методы ---
    private void LoadMore()
    {
        var next = _filteredFlights
            .Skip(_displayedFlights.Count)
            .Take(pageSize)
            .ToList();

        _displayedFlights.AddRange(next);
    }

    private void OnDepartureChanged(DateTime? date)
    {
        _departureDate = date;
        if (_returnDate.HasValue && _departureDate.HasValue && _returnDate < _departureDate)
        {
            _returnDate = null;
        }
    }

    private string GetDayShortName(DayOfWeek day) => day switch
    {
        DayOfWeek.Monday => "Пн",
        DayOfWeek.Tuesday => "Вт",
        DayOfWeek.Wednesday => "Ср",
        DayOfWeek.Thursday => "Чт",
        DayOfWeek.Friday => "Пт",
        DayOfWeek.Saturday => "Сб",
        DayOfWeek.Sunday => "Вс",
        _ => ""
    };

    private int _adultsCount = 1;
    private int _childrenCount = 0;
    private ServiceClass _selectedServiceClass = ServiceClass.Economy;
    private bool _hasExtraBaggage;
    private bool _hasInsurance;

    private void ChangeAdults(int delta) => _adultsCount = Math.Max(1, _adultsCount + delta);
    private void ChangeChildren(int delta) => _childrenCount = Math.Max(0, _childrenCount + delta);

    private decimal CalculateTotalPrice()
    {
        if (_selectedItinerary == null) return 0;

        var priceCalculator = new PriceCalculatorService();
        
        // Рассчитываем цену через сервис с учётом класса обслуживания
        decimal baseTotal = priceCalculator.CalculateTotalItineraryPrice(
            _selectedItinerary,
            _adultsCount,
            _selectedServiceClass,
            SeatLocation.Aisle);

        // Дети платят 70% от цены
        decimal childrenPrice = priceCalculator.CalculateTotalItineraryPrice(
            _selectedItinerary,
            _childrenCount,
            _selectedServiceClass,
            SeatLocation.Aisle) * 0.7m;

        baseTotal += childrenPrice;

        // Доп. услуги
        if (_hasExtraBaggage) baseTotal += 2500 * (_adultsCount + _childrenCount);
        if (_hasInsurance) baseTotal += 500 * (_adultsCount + _childrenCount);

        return baseTotal;
    }



    private IEnumerable<ServiceClass> GetAvailableClassesForItinerary(Itinerary itinerary)
    {
        // Если маршрут пустой, возвращаем эконом по умолчанию
        if (itinerary == null || !itinerary.Flights.Any())
            return new List<ServiceClass> { ServiceClass.Economy };

        // Исправляем ошибку CS1503: работаем с типом ServiceClass вместо string
        return itinerary.Flights
            .Select(f => f.Aircraft.AvailableClasses)
            .Aggregate((prev, next) =>
            {
                var intersect = new HashSet<ServiceClass>(prev);
                intersect.IntersectWith(next);
                return intersect;
            });
    }

    // Принимаем ServiceClass для корректного switch
    private string TranslateClass(ServiceClass sClass) => sClass switch
    {
        ServiceClass.Economy => "Эконом",
        ServiceClass.Comfort => "Комфорт",
        ServiceClass.Business => "Бизнес",
        ServiceClass.First => "Первый",
        _ => sClass.ToString()
    };
}