@page "/"
@rendermode InteractiveServer
@inject IJSRuntime JSRuntime
<PageTitle>Home</PageTitle>

@namespace AirportSystem.Components.Pages

<div class="search-section">
    <div class="container">
        <h2 class="text-center fw-bold mb-5 text-white">Поиск авиабилетов</h2>
        <div class="avia-tabs mb-3">
            @* Используем Enum вместо строк *@
            <button class="avia-tab @(_currentMode == SearchMode.Roundtrip ? "active" : "")"
                    @onclick='() => SetSearchMode(SearchMode.Roundtrip)'>
                Туда и обратно
            </button>
            <button class="avia-tab @(_currentMode == SearchMode.MultiCity ? "active" : "")"
                    @onclick='() => SetSearchMode(SearchMode.MultiCity)'>
                Сложный маршрут
            </button>
        </div>

        <div class="avia-panel shadow-lg">
            @if (_currentMode == SearchMode.Roundtrip)
            {
                <div class="avia-cell border-end">
                    <label class="avia-label">ОТКУДА</label>
                    <select class="avia-select" ">
                        <option value="">Любой город</option>
                    </select>
                </div>
                <div class="avia-cell border-end">
                    <label class="avia-label">КУДА</label>
                    <select class="avia-select">
                        <option value="">Любой город</option>
                    </select>
                </div>
                <div class="avia-cell border-end">
                    <label class="avia-label">ТУДА</label>
                    <input type="date" class="avia-input" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                </div>
                <div class="avia-cell border-end">
                    <label class="avia-label">ОБРАТНО</label>
                    <input type="date" class="avia-input" />
                </div>
                <button type="button" class="btn-search-main">Найти</button>
            }
            else
            {
                <div class="multi-city-container">
                @for (int i = 0; i < Segments.Count; i++)
                {
                    var segmentIndex = i;
                    @* Добавляем @key для стабильной работы удаления *@
                    <div class="segment-row" @key="Segments[i]">
                        <div class="segment-number-badge">@(i + 1)</div>
                            <div class="segment-fields">
                                <div class="segment-field">
                                    <select class="segment-select">
                                        <option value="">Откуда</option>
                                    </select>
                                </div>
                                <div class="segment-arrow">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="#94a3b8" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8z" /></svg>
                                </div>
                                <div class="segment-field">
                                    <select class="segment-select">
                                        <option value="">Куда</option>
                                    </select>
                                </div>
                                <div class="segment-field segment-field-date">
                                    <input type="date" class="segment-date-input" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                                </div>
                        @if (Segments.Count > 2)
                        {
                                <button type="button" class="btn-remove-segment" @onclick="() => RemoveSegment(segmentIndex)" title="Удалить сегмент">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z" /></svg>
                                </button>
                        }
                            </div>
                        </div>
                    }
                    @if (Segments.Count < 5)
                    {
                        <button type="button" class="btn-add-segment" @onclick="() => AddSegment()">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M8 2a.5.5 0 0 1 .5.5v5h5a.5.5 0 0 1 0 1h-5v5a.5.5 0 0 1-1 0v-5h-5a.5.5 0 0 1 0-1h5v-5A.5.5 0 0 1 8 2z" /></svg>
                            Добавить сегмент
                        </button>
                    }
                </div>
                <button type="button" class="btn-search-main">Найти</button>
            }
        </div>
    </div>
</div>
