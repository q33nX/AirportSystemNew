@page "/"
@rendermode InteractiveServer
@inject IJSRuntime JSRuntime
@using AirportSystem.Core.Entities
@using AirportSystem.Core.Services
@using AirportSystem.Core.Interfaces
@using AirportSystem.Core.ViewModels

@inject FlightSearchService FlightSearchService

<PageTitle>Home</PageTitle>

@namespace AirportSystem.Components.Pages

<div class="search-section @(_isSearchPerformed ? "mini" : "full-screen")">
    <div class="container">
        <h2 class="text-center fw-bold mb-5 text-white">Поиск авиабилетов</h2>

        <div class="avia-tabs mb-3">
            @* Используем Enum вместо строк *@
            <button class="avia-tab @(_currentMode == SearchMode.Roundtrip ? "active" : "")"
                    @onclick='() => SetSearchMode(SearchMode.Roundtrip)'>
                Туда и обратно
            </button>
            <button class="avia-tab @(_currentMode == SearchMode.MultiCity ? "active" : "")"
                    @onclick='() => SetSearchMode(SearchMode.MultiCity)'>
                Сложный маршрут
            </button>
        </div>

        <div class="avia-panel shadow-lg">
            @if (_currentMode == SearchMode.Roundtrip)
            {
                <div class="main-search-row">
                    <CitySelect Placeholder="Откуда" Cities="_cities" OnCitySelected="c => _departureCity = c" />
                    <CitySelect Placeholder="Куда" Cities="_cities" OnCitySelected="c => _arrivalCity = c" />
                    <DateSelect Placeholder="Когда" SelectedDate="@_departureDate" MinDate="@DateTime.Now" OnDateSelected="@OnDepartureChanged" />
                    <DateSelect Placeholder="Обратно" SelectedDate="@_returnDate" MinDate="@(_departureDate ?? DateTime.Now)" OnDateSelected="@(d => _returnDate = d)" />
                    <button type="button" class="btn-search-main" @onclick="() => HandleSearch()">Найти</button>
                </div>
            }
            else
            {
                <div class="multi-city-container">
                    @foreach (var segment in Segments)
                    {
                        <div class="segment-row fade-in-row" @key="segment">
                            <CitySelect Placeholder="Откуда" Cities="_cities" />
                            <CitySelect Placeholder="Куда" Cities="_cities"  />
                            <DateSelect Placeholder="Когда" />

                            @if (Segments.Count > 2)
                            {
                                <button type="button" class="btn-remove-segment" @onclick="() => RemoveSegment(segment)">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z" /></svg>
                                </button>
                            }
                        </div>
                    }
                    <div class="multi-actions-row">
                        @if (Segments.Count < 5)
                        {
                            <button type="button" class="btn-add-segment" @onclick="AddSegment" disabled="@(Segments.Count >= 5)">
                                <i class="bi bi-plus-lg"></i> Добавить перелет
                            </button>
                        }
                        <button type="button" class="btn-search-large" @onclick="HandleSearch">Найти</button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@if (_isSearchPerformed)
{
    <div class="container mt-5 mb-5 animate-results">
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="sorting-panel mb-4 p-3 bg-white rounded-4 shadow-sm d-flex align-items-center gap-3 flex-wrap">
                    <span class="text-muted small fw-bold text-uppercase">Сортировка:</span>
                    <div class="d-flex gap-2">
                        <button class="btn btn-sort @(_activeSort == "price" ? "active" : "")" @onclick='() => SetSort("price")'>
                            Цена <i class="sort-icon @(_activeSort == "price" ? (_isAscending ? "asc" : "desc") : "")"></i>
                        </button>
                        <button class="btn btn-sort @(_activeSort == "duration" ? "active" : "")" @onclick='() => SetSort("duration")'>
                            Время <i class="sort-icon @(_activeSort == "duration" ? (_isAscending ? "asc" : "desc") : "")"></i>
                        </button>
                        <button class="btn btn-sort @(_activeSort == "comfort" ? "active" : "")" @onclick='() => SetSort("comfort")'>
                            Комфорт <i class="sort-icon @(_activeSort == "comfort" ? (_isAscending ? "asc" : "desc") : "")"></i>
                        </button>
                    </div>
                    <span class="ms-auto count-badge">
                        @if (_flights != null && _flights.Any())
                        {
                            <span>Найдено рейсов: @_flights.Count</span>
                        }
                    </span>
                </div>

                @if (_displayedFlights != null && _displayedFlights.Any())
                {
                    @foreach (var flight in _displayedFlights)
                    {
                        <div class="ticket-card shadow-sm mb-4 bg-white animate-fade-in">
                            <div class="row g-0 align-items-stretch">
                                <div class="col-md-9 p-4 d-flex align-items-center">
                                    <div class="w-100">
                                        <div class="flight-route-info">
                                            <div class="d-flex justify-content-between mb-2">
                                                <span class="text-muted small fw-bold pe-3">@flight.Status</span>
                                                <span class="text-muted small fw-bold pe-3">@flight.Schema.FlightNumber</span>
                                            </div>
                                            <div class="d-flex align-items-center justify-content-between text-center">
                                                <div class="text-start" style="min-width: 85px;">
                                                    <div class="h3 fw-bold m-0 text-dark">@flight.Schema.Origin.Code</div>
                                                    <div class="small text-muted text-truncate" style="max-width: 90px;">@flight.Schema.Origin.City.Name</div>
                                                    <div class="small fw-bold text-secondary mt-1">@flight.DepartureDate.ToString("dd MMM")</div>
                                                </div>
                                                <div class="flex-grow-1 px-3">
                                                    <div class="mb-1">
                                                        <span class="small fw-bold text-primary">@flight.Schema.Carrier.Name</span>
                                                    </div>
                                                    <div class="mb-2">
                                                        <span class="h4 fw-bold text-primary">@flight.ActualDepartureTime.ToString("HH:mm")</span>
                                                        <span class="mx-2 text-muted">—</span>
                                                        <span class="h4 fw-bold text-primary">@flight.ActualArrivalTime.ToString("HH:mm")</span>
                                                    </div>
                                                    <div class="path-line"><i class="bi bi-airplane-fill"></i></div>
                                                    <div class="mb-3">
                                                        <span class="small fw-bold text-muted">@flight.ActualDuration</span>
                                                    </div>
                                                </div>
                                                <div class="text-end" style="min-width: 85px;">
                                                    <div class="h3 fw-bold m-0 text-dark">@flight.Schema.Destination.Code</div>
                                                    <div class="small text-muted text-truncate" style="max-width: 90px;">@flight.Schema.Destination.City.Name</div>
                                                    <div class="small fw-bold text-secondary mt-1">@flight.DepartureDate.AddMinutes(flight.ActualDuration.TotalMinutes).ToString("dd MMM")</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-3 p-4 border-start border-dashed bg-light d-flex flex-column justify-content-center text-center price-panel">
                                    <div class="text-muted small mb-1">Цена от</div>
                                    <div class="h2 fw-bold mb-3 text-primary">@flight.BasePrice</div>
                                    <button class="btn btn-warning w-100 fw-bold text-white rounded-pill py-2 shadow-sm">Подробнее</button>
                                </div>
                            </div>
                        </div>
                    }

                    @if (_displayedFlights.Count < _flights.Count)
                    {
                        <div class="text-center mt-5">
                            <button class="btn btn-outline-primary px-5 py-3 fw-bold rounded-pill shadow-sm load-more-btn" @onclick="LoadMore">
                                Показать еще
                            </button>
                            <p class="text-muted small mt-2">Показано @_displayedFlights.Count из @_flights.Count рейсов</p>
                        </div>
                    }
                }
                else
                {
                    <div class="no-results-card p-5 text-center bg-white rounded-4 border">
                        <div class="mb-3">
                            <i class="bi bi-airplane fs-1 text-muted"></i>
                        </div>
                        <h5 class="fw-bold text-secondary mb-2">Рейсы не найдены</h5>
                        <p class="text-muted mb-0">Попробуйте изменить критерии поиска</p>
                    </div>
                }
            </div>

            <div class="col-lg-4 d-none d-lg-block">
                <div class="filter-panel p-4 bg-white rounded-4 shadow-sm border sticky-top" style="top: 20px;" role="region" aria-label="Фильтры поиска">
                    <div class="filter-header d-flex justify-content-between align-items-center mb-4">
                        <h5 class="fw-bold m-0 text-dark">
                            <i class="bi bi-sliders2-vertical me-2 text-primary"></i>Фильтры
                        </h5>
                        <button class="btn btn-link btn-sm text-decoration-none p-0 filter-reset-btn">Сбросить все</button>
                    </div>

                    <div class="filter-section mb-4">
                        <label class="filter-label">Класс обслуживания</label>
                        <div class="class-selector">
                            <input type="radio" name="flightClass" id="econ" checked>
                            <label for="econ">Эконом</label>

                            <input type="radio" name="flightClass" id="comf">
                            <label for="econ">Комфорт</label>

                            <input type="radio" name="flightClass" id="biz">
                            <label for="biz">Бизнес</label>

                            <input type="radio" name="flightClass" id="first">
                            <label for="first">Первый</label>
                        </div>
                    </div>

                    <div class="filter-section mb-4">
                        <label class="filter-label">Дни вылета</label>
                        <div class="days-grid">
                            <label class="day-item"><input type="checkbox"><span>Пн</span></label>
                            <label class="day-item"><input type="checkbox"><span>Вт</span></label>
                            <label class="day-item"><input type="checkbox"><span>Ср</span></label>
                            <label class="day-item"><input type="checkbox"><span>Чт</span></label>
                            <label class="day-item"><input type="checkbox" checked><span>Пт</span></label>
                            <label class="day-item"><input type="checkbox" checked><span>Сб</span></label>
                            <label class="day-item"><input type="checkbox"><span>Вс</span></label>
                        </div>
                    </div>

                    <div class="filter-section mb-4">
                        <label class="filter-label">Пересадки</label>
                        <div class="filter-stack">
                            <div class="custom-check-item">
                                <label class="check-container">
                                    <span class="check-text">Без пересадок</span>
                                    <span class="check-price">от 14 500 ₽</span>
                                    <input type="checkbox" checked>
                                    <span class="checkmark"></span>
                                </label>
                            </div>
                            <div class="custom-check-item">
                                <label class="check-container">
                                    <span class="check-text">1 пересадка</span>
                                    <span class="check-price">от 8 200 ₽</span>
                                    <input type="checkbox">
                                    <span class="checkmark"></span>
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="filter-section mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <label class="filter-label m-0">Цена</label>
                            <span class="price-value-badge">до 120 000 ₽</span>
                        </div>
                        <input type="range" class="styled-range" min="5000" max="250000" step="1000">
                        <div class="d-flex justify-content-between mt-2">
                            <span class="range-limit">5 000</span>
                            <span class="range-limit">250 000</span>
                        </div>
                    </div>

                    <div class="filter-section mb-4">
                        <label class="filter-label">Авиакомпании</label>
                        <div class="filter-scroll-area">
                            <div class="custom-check-item">
                                <label class="check-container">
                                    <span class="check-text">Aeroflot</span>
                                    <input type="checkbox" checked>
                                    <span class="checkmark"></span>
                                </label>
                            </div>
                            <div class="custom-check-item">
                                <label class="check-container">
                                    <span class="check-text">S7 Airlines</span>
                                    <input type="checkbox">
                                    <span class="checkmark"></span>
                                </label>
                            </div>
                            <div class="custom-check-item">
                                <label class="check-container">
                                    <span class="check-text">Turkish Airlines</span>
                                    <input type="checkbox">
                                    <span class="checkmark"></span>
                                </label>
                            </div>
                            <div class="custom-check-item">
                                <label class="check-container">
                                    <span class="check-text">Emirates</span>
                                    <input type="checkbox">
                                    <span class="checkmark"></span>
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="filter-section">
                        <label class="filter-label">Время вылета</label>
                        <div class="time-grid">
                            <button class="time-chip active">
                                <i class="bi bi-brightness-alt-high"></i>
                                <span>Утро</span>
                            </button>
                            <button class="time-chip">
                                <i class="bi bi-sun"></i>
                                <span>День</span>
                            </button>
                            <button class="time-chip">
                                <i class="bi bi-moon-stars"></i>
                                <span>Вечер</span>
                            </button>
                            <button class="time-chip">
                                <i class="bi bi-cloud-moon"></i>
                                <span>Ночь</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}



@code {
    // Переменные для хранения выбранных данных
    private City? _departureCity;
    private City? _arrivalCity;

    // Инициализируем даты, чтобы не было ошибок
    private DateTime? _departureDate;
    private DateTime? _returnDate;

    private List<City> _cities = new();

    private int pageSize = 10;
    private string today = DateTime.Today.ToString("yyyy-MM-dd");

    private bool _isSearching = false;

    // Инициализируем пустыми списками, чтобы избежать null-checks в разметке
    private List<FlightInstance> _displayedFlights = new();
    private List<FlightInstance> _flights = new();

    private FlightSearchModel searchModel = new();

    private bool _isSearchPerformed = false;

    private void OnDepartureChanged(DateTime? date)
    {
        _departureDate = date;

        // Если дата возврата уже выбрана И она стала раньше новой даты вылета
        if (_returnDate.HasValue && _departureDate.HasValue && _returnDate < _departureDate)
        {
            // Сбрасываем дату возврата в null, чтобы сработал плейсхолдер
            _returnDate = null;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // Подгружаем города при инициализации
        _cities = await FlightSearchService.GetAvailableCitiesAsync();
        ResetSegments();
    }

    private void ResetSegments()
    {
        Segments = new List<FlightSchema> {
            new() { },
            new() { }
        };
    }

    private async Task HandleSearch()
    {
        _isSearching = true;
        _displayedFlights.Clear();

        try
        {
            // Обращаемся к сервису, а не напрямую к источнику данных
            _flights = await FlightSearchService.SearchFlights(_departureCity, _arrivalCity, _departureDate );

            if (_flights.Any())
            {
                LoadMore();
                _isSearchPerformed = true; // Триггер анимации и показа результатов
            }
        }
        catch (Exception ex)
        {
            // Логируем ошибку
        }
        finally
        {
            _isSearching = false;
        }
    }

    private void LoadMore()
    {
        if (_flights == null || !_flights.Any()) return;

        var next = _flights
            .Skip(_displayedFlights.Count)
            .Take(pageSize)
            .ToList();

        _displayedFlights.AddRange(next);
    }

    private string _activeSort = "price";
    private bool _isAscending = true;

    private void SetSort(string criterion)
    {
        if (_activeSort == criterion)
        {
            _isAscending = !_isAscending; // Меняем направление, если кликнули на ту же кнопку
        }
        else
        {
            _activeSort = criterion;
            _isAscending = true; // Сбрасываем на "по возрастанию" для нового критерия
        }

        // Здесь должна быть твоя логика сортировки списка _flights
        SortFlights();
    }

    private void SortFlights()
    {
        // Пример базовой сортировки (адаптируй под свои поля)
        if (_activeSort == "price")
        {
            _flights = _isAscending
                ? _flights.OrderBy(f => f.BasePrice).ToList()
                : _flights.OrderByDescending(f => f.BasePrice).ToList();
        }

        if (_activeSort == "duration")
        {
            _flights = _isAscending
                ? _flights.OrderBy(f => f.ActualDuration).ToList()
                : _flights.OrderByDescending(f => f.ActualDuration).ToList();
        }

        // После сортировки обновляем отображаемые данные
        _displayedFlights = _flights.Take(_displayedFlights.Count).ToList();
    }
}